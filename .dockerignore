# Version control
.git
.gitignore
.github/

# Documentation (not needed inside the image)
README.md
*.md

# Node.js artifacts (if you ever add build tools)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Python virtual environments (if you ever use Python tools)
.venv/
__pycache__/
*.pyc

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log

# Test files (not needed in production image)
tests/
test/
*.test.js
*.spec.js

# Environment files (never put secrets in Docker images)
.env
.env.local
.env.production
.env.*.local